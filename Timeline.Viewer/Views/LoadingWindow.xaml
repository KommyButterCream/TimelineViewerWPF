<Window x:Class="Timeline.Viewer.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="로그 여는 중"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <StackPanel Margin="24">
        <TextBlock Text="로그 파일을 열고 있습니다"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <TextBlock Text="{Binding LoadingStageText}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   MinHeight="40"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <ProgressBar Height="4"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource DividerBrush}"
                     BorderThickness="0"
                     AutomationProperties.Name="로그 파일 처리 중"
                     Margin="0,0,0,20"/>

        <Button Content="취소"
                Command="{Binding CancelLoadCommand}"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Right"
                MinWidth="88"/>
    </StackPanel>
</Window>

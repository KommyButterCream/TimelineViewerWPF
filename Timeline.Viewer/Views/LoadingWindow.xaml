<Window
    x:Class="Timeline.Viewer.Views.LoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="로그 여는 중"
    Width="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    WindowStyle="None"
    UseLayoutRounding="True"
    Background="{DynamicResource SurfaceBrush}"
    Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- 사용자 지정 창 프레임: 기본 타이틀바 없이 창 이동 등의 시스템 기능을 연결 -->
    <WindowChrome.WindowChrome>
        <!-- 위쪽 32 DIP는 드래그 영역으로 사용하고, 크기 조절 영역과 유리 프레임은 사용하지 않음 -->
        <WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="0"
            GlassFrameThickness="0"
            CornerRadius="10" />
    </WindowChrome.WindowChrome>
    <!-- 대기 카드 외곽: 테마 배경, 1 DIP 테두리와 내부 여백 설정 -->
    <Border
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="1"
        Padding="24"
        Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
        
        <!-- 세로 배치: 안내 문구, 진행 표시, 취소 버튼을 위에서 아래로 배치 -->
        <StackPanel>
            
            <!-- 상단 분류 문구: cyan 강조 색상으로 로딩 화면임을 표시 -->
            <TextBlock
                Text="LOADING TRACE"
                FontSize="11"
                Foreground="{DynamicResource AccentBrush}"
                Margin="0,0,0,12" />
            
            <!-- 대기 창 제목: 현재 작업을 사용자에게 안내 -->
            <TextBlock
                Text="타임라인을 준비하고 있습니다"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,0,0,16" />
            
            <!-- 처리 상태: ViewModel의 단계·레코드 수·취소 대기 문구를 바인딩으로 갱신 -->
            <TextBlock
                Text="{Binding LoadingStageText}"
                Foreground="{DynamicResource SecondaryTextBrush}"
                MinHeight="40"
                TextWrapping="Wrap"
                Margin="0,0,0,16" />
            
            <!-- 진행 표시: 정확한 백분율 대신 IsIndeterminate로 작업이 진행 중임을 표현 -->
            <ProgressBar
                Height="4"
                IsIndeterminate="True"
                Foreground="{DynamicResource AccentBrush}"
                Background="{DynamicResource DividerBrush}"
                BorderThickness="0"
                AutomationProperties.Name="로그 파일 처리 중"
                Margin="0,0,0,20" />
            
            <!-- 취소 버튼: CancelLoadCommand를 실행하며, 실행 가능 여부에 따라 자동으로 활성화됨 -->
            <!-- IsHitTestVisibleInChrome은 타이틀바 영역에서도 버튼 클릭을 허용하는 설정 -->
            <Button
                Content="취소"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Command="{Binding CancelLoadCommand}"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Right"
                MinWidth="88" />
        </StackPanel>
    </Border>
</Window>

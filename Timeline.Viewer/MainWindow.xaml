<Window
    x:Class="Timeline.Viewer.MainWindow"
    x:Name="MainShell"
    xmlns:services="clr-namespace:Timeline.Viewer.Services"
    services:PopupMaterial.Theme="{Binding CurrentTheme}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Timeline.Viewer"
    xmlns:controls="clr-namespace:Timeline.Viewer.Controls"
    xmlns:converters="clr-namespace:Timeline.Viewer.Converters"
    mc:Ignorable="d"
    Title="Timeline.Viewer"
    WindowStyle="None"
    Background="{DynamicResource SurfaceBrush}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    Width="1280"
    Height="760"
    MinWidth="900"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    AllowDrop="True"
    PreviewDragOver="OnFileDragOver"
    PreviewDrop="OnFileDrop">

    <!-- 창 프레임: 사용자 지정 타이틀바의 드래그 영역과 창 크기 조절 영역 -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="52"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="8"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Converter 객체 등록 -->
        <converters:TrackBrushConverter
            x:Key="TrackBrushConverter" />
    </Window.Resources>

    <!-- 전체 레이아웃: 상단 타이틀바와 나머지 작업 화면 -->
    <Grid
        Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
        TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="52" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>


        <!-- 타이틀바: cyan 로고, 앱 이름, 최소화·최대화·닫기 버튼 -->
        <Border
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,0,8,0">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    VerticalAlignment="Center">
                    <Button
                        Content=""
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="OnMinimize"
                        AutomationProperties.Name="최소화" />
                    <Button
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="OnMaximizeRestore"
                        AutomationProperties.Name="최대화 또는 복원">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Text"
                                        Value="" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{
                                                Binding WindowState,
                                                RelativeSource=
                                                {RelativeSource AncestorType=Window}}"
                                            Value="Maximized">
                                            <Setter
                                                Property="Text"
                                                Value="" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button
                        Content=""
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="OnCloseWindow"
                        AutomationProperties.Name="닫기" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <StackPanel
                        Orientation="Horizontal"
                        Height="22"
                        Margin="0,0,12,0">
                        <Border
                            Width="4"
                            Height="15"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,3,0" />
                        <Border
                            Width="4"
                            Height="22"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,3,0" />
                        <Border
                            Width="4"
                            Height="9"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock
                        Text="TIMELINE.VIEWER"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="VIEWER / FOCUS"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        FontSize="11"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid
            Grid.Row="1"
            Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>


            <!-- 상단 도구 모음 -->
            <Border
                Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Orientation="Horizontal">
                        <Button
                            Content="로그 열기"
                            Command="{Binding OpenFileCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Content="샘플"
                            Command="{Binding OpenSampleCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Margin="6,0,12,0" />
                    </StackPanel>
                    <DockPanel
                        Grid.Column="1"
                        MaxWidth="560"
                        HorizontalAlignment="Left">
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="6,0,0,0">
                            <Button
                                Content="검색"
                                Command="{Binding SearchCommand}"
                                ToolTip="{Binding SearchSummary}" />
                            <Button
                                Content="이전"
                                Command="{Binding PreviousSearchResultCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,6" />
                            <Button
                                Content="다음"
                                Command="{Binding NextSearchResultCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,6" />
                        </StackPanel>
                        <TextBox
                            MinWidth="140"
                            MaxWidth="320"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Span 이름 · ID · Track 검색"
                            AutomationProperties.Name="Span 이름 또는 ID 검색">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="12,0,0,0">
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding ReadModes}"
                            SelectedItem="{Binding SelectedReadMode, Mode=TwoWay}"
                            VerticalContentAlignment="Center"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="로그 읽기 모드" />
                        <Button
                            Content="{Binding ThemeButtonText}"
                            Command="{Binding ToggleThemeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>


            <!-- 중앙 작업 영역 -->
            <Grid
                Grid.Row="1"
                Visibility="{Binding HasSession, Converter={StaticResource BooleanVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="280" />
                </Grid.ColumnDefinitions>


                <!-- 세션 요약: 현재 파일 이름과 Track·Span 개수 -->
                <StackPanel
                    Grid.ColumnSpan="2"
                    Margin="20,14">
                    <TextBlock
                        Text="TRACE SESSION"
                        FontSize="10"
                        Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock
                        Text="{Binding SessionTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,4" />
                    <TextBlock
                        Text="{Binding SessionSummary}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        FontSize="12" />
                </StackPanel>


                <!-- 타임라인 영역: 확대·축소 도구, 시간축과 구간, 양축 스크롤, 범례 -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel
                            Margin="0,0,0,6">
                            <StackPanel
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <Button
                                    Content="−"
                                    Click="OnZoomOut"
                                    Width="32"
                                    Padding="0,5"
                                    ToolTip="화면 중앙 기준 축소"
                                    AutomationProperties.Name="타임라인 축소" />
                                <Button
                                    Content="+"
                                    Click="OnZoomIn"
                                    Width="32"
                                    Padding="0,5"
                                    Margin="6,0"
                                    ToolTip="화면 중앙 기준 확대"
                                    AutomationProperties.Name="타임라인 확대" />
                                <Button
                                    Content="전체 맞춤"
                                    Click="OnFitToView"
                                    Padding="10,5" />
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="TIMELINE / ms"
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock
                                    Text="   Ctrl + 휠 확대 · 중간 버튼 드래그 이동"
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="8,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border
                            Grid.Row="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,2,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="*" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>


                                <!-- 타임라인 그리기: 시간 눈금·Track·Span 렌더링과 선택·마우스 입력 처리 -->
                                <controls:TimelineSurface
                                    x:Name="TimelineView"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Tracks="{Binding Tracks}"
                                    AxisBrush="{DynamicResource SecondaryTextBrush}"
                                    SelectionBrush="{DynamicResource AccentBrush}"
                                    GridLineBrush="{DynamicResource DividerBrush}"
                                    SelectedSpan="{Binding SelectedSpan, Mode=TwoWay}" />


                                <!-- 세로 스크롤: Track과 겹침 레인을 위아래로 탐색 -->
                                <ScrollBar
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Minimum="0"
                                    Maximum="{Binding VerticalAxis.MaxOffset, ElementName=TimelineView}"
                                    ViewportSize="{Binding VerticalAxis.Viewport, ElementName=TimelineView}"
                                    LargeChange="{Binding VerticalAxis.Viewport, ElementName=TimelineView}"
                                    SmallChange="24"
                                    Value="{Binding VerticalAxis.Offset, ElementName=TimelineView, Mode=TwoWay}" />


                                <!-- 가로 스크롤: 시간 눈금과 Span을 함께 좌우로 이동 -->
                                <ScrollBar
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Minimum="0"
                                    Maximum="{Binding HorizontalAxis.MaxOffset, ElementName=TimelineView}"
                                    ViewportSize="{Binding HorizontalAxis.Viewport, ElementName=TimelineView}"
                                    LargeChange="{Binding HorizontalAxis.Viewport, ElementName=TimelineView}"
                                    SmallChange="24"
                                    Value="{Binding HorizontalAxis.Offset, ElementName=TimelineView, Mode=TwoWay}" />
                            </Grid>
                        </Border>


                        <!-- 타임라인 범례: Track별 색상과 종료 누락 표시 안내 -->
                        <ScrollViewer
                            Grid.Row="2"
                            MaxHeight="64"
                            Margin="0,5,0,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel>
                                <ItemsControl
                                    ItemsSource="{Binding Tracks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Margin="0,0,12,0">
                                                <Rectangle
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,5,0"
                                                    Fill="{Binding Id, Converter={StaticResource TrackBrushConverter}}" />
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Text="│ 0 ms   ▧ 종료 누락 (표시 범위까지)"
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryTextBrush}" />
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <!-- Inspector: 선택한 Span의 시간·상태·Args·원본 위치를 표시하는 오른쪽 패널 -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    d:Visibility="Visible"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16">
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock
                                Text="INSPECTOR"
                                Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="선택한 Span"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,24,0,8" />
                            <TextBlock
                                Text="{Binding SelectedSpan.Name, TargetNullValue='선택 없음', FallbackValue='선택 없음'}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="16"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding SelectedSpan.Id, TargetNullValue='—', FallbackValue='—'}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,8,0,0"
                                TextWrapping="Wrap" />
                            <Grid
                                Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Text="시작 시각"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,0,16,8" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SelectedSpan.StartTimeText, TargetNullValue='—', FallbackValue='—'}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,8" />
                                <TextBlock
                                    Grid.Row="1"
                                    Text="종료 시각"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,0,16,8" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding SelectedSpan.EndTimeText, TargetNullValue='—', FallbackValue='—'}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,8" />
                                <TextBlock
                                    Grid.Row="2"
                                    Text="소요 시간"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,0,16,8" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding SelectedSpan.DurationText, TargetNullValue='—', FallbackValue='—'}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,8" />
                                <TextBlock
                                    Grid.Row="3"
                                    Text="상태"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,0,16,0" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding SelectedSpan.StatusText, TargetNullValue='—', FallbackValue='—'}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock
                                Text="Args"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,24,0,8" />
                            <TextBox
                                Text="{Binding SelectedSpan.ArgsText, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                MaxHeight="200"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Background="{DynamicResource CanvasBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Padding="8"
                                FontFamily="Consolas" />
                            <TextBlock
                                Text="원본 위치"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,24,0,8" />
                            <TextBox
                                Text="{Binding SelectedSpan.SourceFileText, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                Background="{DynamicResource CanvasBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Padding="8" />
                            <Grid
                                Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="시작 레코드"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,0,16,8" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding SelectedSpan.BeginLineText, TargetNullValue='—', FallbackValue='—'}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Margin="0,0,0,8" />
                                <TextBlock
                                    Grid.Row="1"
                                    Text="종료 레코드"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Margin="0,0,16,0" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding SelectedSpan.EndLineText, TargetNullValue='—', FallbackValue='—'}"
                                    Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Grid>


                            <!-- Track 탐색: Track 선택, 펼치기·접기와 해당 Track의 구간 목록 -->
                            <Expander
                                Header="Track · 구간 탐색"
                                IsExpanded="False"
                                Margin="0,18,0,0"
                                Foreground="{DynamicResource SecondaryTextBrush}">
                                <StackPanel>
                                    <ComboBox
                                        ItemsSource="{Binding Tracks}"
                                        SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        MinHeight="32"
                                        Margin="0,8"
                                        AutomationProperties.Name="Track 선택" />
                                    <TextBlock
                                        Text="선택한 Track"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Margin="0,24,0,6" />
                                    <TextBlock
                                        Text="{Binding SelectedTrack.Name, TargetNullValue='선택 없음', FallbackValue='선택 없음'}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="18"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="Track ID"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Margin="0,20,0,6" />
                                    <TextBlock
                                        Text="{Binding SelectedTrack.Id, TargetNullValue='—', FallbackValue='—'}"
                                        Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <CheckBox
                                        Content="타임라인에서 Track 펼치기"
                                        IsChecked="{Binding SelectedTrack.IsExpanded, Mode=TwoWay}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Margin="0,2,0,0">
                                        <CheckBox.Style>
                                            <Style
                                                TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding SelectedTrack}"
                                                        Value="{x:Null}">
                                                        <Setter
                                                            Property="IsEnabled"
                                                            Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <TextBlock
                                        Text="작업 목록"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Margin="0,24,0,8" />
                                    <ListBox
                                        ItemsSource="{Binding SelectedTrack.Spans}"
                                        SelectedItem="{Binding SelectedSpan, Mode=TwoWay}"
                                        MaxHeight="120"
                                        Background="{DynamicResource CanvasBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderThickness="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel
                                                    Margin="0,4">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="{Binding DurationText}"
                                                        Margin="0,4,0,0"
                                                        FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>


            <!-- 하단 상태 표시줄과 진단 목록 -->
            <Border
                Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="12,6">
                <Expander
                    IsExpanded="{Binding IsDiagnosticsExpanded, Mode=TwoWay}"
                    HorizontalContentAlignment="Stretch"
                    Foreground="{DynamicResource PrimaryTextBrush}">
                    <Expander.Header>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="{Binding StatusText}"
                                ToolTip="{Binding StatusText}"
                                MaxWidth="650"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="11" />
                            <TextBlock
                                Text="{Binding DiagnosticSummary}"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="11"
                                Margin="16,0,0,0" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid
                        Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="3*" />
                            <ColumnDefinition
                                Width="2*" />
                        </Grid.ColumnDefinitions>


                        <!-- 진단 목록: Reader·Analysis 진단을 가상화하고 선택한 진단을 ViewModel에 전달 -->
                        <ListView
                            ItemsSource="{Binding Diagnostics}"
                            SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}"
                            SelectionMode="Single"
                            Height="180"
                            Background="{DynamicResource CanvasBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            AutomationProperties.Name="진단 목록">
                            <ListView.ItemContainerStyle>
                                <Style
                                    TargetType="ListViewItem">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter
                                        Property="ToolTip"
                                        Value="{Binding Message}" />
                                    <Setter
                                        Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate
                                                TargetType="ListViewItem">
                                                <Border
                                                    x:Name="RowBorder"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="Transparent"
                                                    Padding="0,2">
                                                    <GridViewRowPresenter
                                                        Content="{TemplateBinding Content}"
                                                        Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger
                                                        Property="IsMouseOver"
                                                        Value="True">
                                                        <Setter
                                                            TargetName="RowBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource SurfaceBrush}" />
                                                    </Trigger>
                                                    <Trigger
                                                        Property="IsSelected"
                                                        Value="True">
                                                        <Setter
                                                            TargetName="RowBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource SurfaceBrush}" />
                                                        <Setter
                                                            TargetName="RowBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Style>
                                <Style
                                    TargetType="{x:Type ListView}">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasDiagnostics}"
                                            Value="False">
                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Style>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        Header="출처"
                                        Width="70"
                                        DisplayMemberBinding="{Binding SourceText}" />
                                    <GridViewColumn
                                        Header="코드"
                                        Width="170"
                                        DisplayMemberBinding="{Binding Code}" />
                                    <GridViewColumn
                                        Header="원본 위치"
                                        Width="100"
                                        DisplayMemberBinding="{Binding LocationText}" />
                                    <GridViewColumn
                                        Header="내용"
                                        Width="600"
                                        DisplayMemberBinding="{Binding Message}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock
                            Text="현재 문서에는 진단이 없습니다."
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Margin="8">
                            <TextBlock.Style>
                                <Style
                                    TargetType="{x:Type TextBlock}">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasDiagnostics}"
                                            Value="False">
                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>


                        <!-- 원본 미리보기: 선택한 진단의 원본 줄·관련 줄 조회와 결과 표시 -->
                        <Grid
                            Grid.Column="1"
                            Height="180"
                            Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="Auto" />
                                <RowDefinition
                                    Height="Auto" />
                                <RowDefinition
                                    Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="{Binding DiagnosticNavigationText}"
                                ToolTip="{Binding SelectedDiagnostic.Message}"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource SecondaryTextBrush}" />
                            <WrapPanel
                                Grid.Row="1"
                                Margin="0,6">
                                <Button
                                    Content="원본 줄 보기"
                                    Command="{Binding ShowSourceCommand}"
                                    Padding="8,3"
                                    Margin="0,0,6,0" />
                                <Button
                                    Content="관련 줄 보기"
                                    Command="{Binding ShowRelatedSourceCommand}"
                                    Padding="8,3" />
                            </WrapPanel>
                            <TextBox
                                Grid.Row="2"
                                Text="{Binding SourcePreviewText, Mode=OneWay}"
                                IsReadOnly="True"
                                FontFamily="Consolas"
                                FontSize="12"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                Background="{DynamicResource CanvasBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Padding="6"
                                AutomationProperties.Name="원본 줄 미리보기" />
                        </Grid>
                    </Grid>
                </Expander>
            </Border>


            <!-- 대기 창 배경: 지연 로딩 창이 표시될 때 작업 화면을 어둡게 덮는 영역 -->
            <Border
                x:Name="BusyShade"
                Grid.RowSpan="3"
                Panel.ZIndex="10"
                Background="#60000000"
                Visibility="Collapsed" />


            <!-- 시작 화면: 세션이 생기면 작업 영역으로 전환 -->
            <Grid
                Grid.Row="1"
                d:Visibility="Collapsed"
                Background="{DynamicResource CanvasBrush}">
                <Grid.Style>
                    <Style
                        TargetType="Grid">
                        <Setter
                            Property="Visibility"
                            Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasSession}"
                                Value="True">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="540"
                    Margin="30">
                    <TextBlock
                        Text="A CLEAR VIEW OF EXECUTION"
                        FontSize="11"
                        TextAlignment="Center"
                        Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock
                        Text="실행의 흐름을 살펴보세요."
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        Margin="0,14,0,10" />
                    <TextBlock
                        Text="Timeline JSONL 파일을 열어 Track과 구간을 확인합니다."
                        TextAlignment="Center"
                        Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock
                        Text="파일을 이 창에 끌어다 놓아도 됩니다."
                        TextAlignment="Center"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Margin="0,6,0,24" />
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Button
                            Content="로그 파일 열기"
                            Command="{Binding OpenFileCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Content="샘플 살펴보기"
                            Command="{Binding OpenSampleCommand}"
                            Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>


            <!-- 알림 Popup: 독립 HWND에 Acrylic 적용, 메인 창 활성 상태에서만 표시 -->
            <Border x:Name="NotificationAnchor" Grid.Row="1" Width="0" Height="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" />
            <Popup x:Name="NotificationPopup"
                Grid.Row="1" PlacementTarget="{Binding ElementName=NotificationAnchor}"
                Placement="Top" HorizontalOffset="-340"
                AllowsTransparency="False" StaysOpen="True" Focusable="False"
                services:PopupMaterial.IsEnabled="True"
                services:PopupMaterial.Theme="{Binding PlacementTarget.(services:PopupMaterial.Theme), RelativeSource={RelativeSource Self}}"
                services:PopupMaterial.UseMaterial="{Binding PlacementTarget.(services:PopupMaterial.UseMaterial), RelativeSource={RelativeSource Self}}">
                <Popup.Style>
                    <Style TargetType="Popup">
                        <Setter Property="IsOpen" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasNotification}" Value="True" />
                                    <Condition Binding="{Binding IsActive, ElementName=MainShell}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsOpen" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>
                <Border Width="340" Padding="18" Background="{DynamicResource SurfaceBrush}"
                    TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Content="×"
                            Command="{Binding DismissNotificationCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="6,0"
                            AutomationProperties.Name="알림 닫기" />
                        <TextBlock
                            Text="TIMELINE · 알림"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock
                        Text="{Binding NotificationText}"
                        TextWrapping="Wrap"
                        Margin="0,10,0,14"
                        Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button
                        Content="진단 확인"
                        Click="OnShowDiagnostics"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HasDiagnostics, Converter={StaticResource BooleanVisibility}}" />
                </StackPanel>
            </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Timeline.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timeline.Viewer"
        xmlns:controls="clr-namespace:Timeline.Viewer.Controls"
        xmlns:converters="clr-namespace:Timeline.Viewer.Converters"
        mc:Ignorable="d"
        Title="Timeline.Viewer"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:TrackBrushConverter x:Key="TrackBrushConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 도구 모음 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Content="로그 열기"
                        Style="{StaticResource AccentButtonStyle}" />

                <TextBlock Text="Timeline.Viewer"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />

                <Button Content="{Binding ThemeButtonText}"
                        Command="{Binding ToggleThemeCommand}"
                        Margin="8,0,0,0"
                        Padding="12,6" />

                <Button Content="샘플 Span 추가"
                        Command="{Binding AddSampleSpanCommand}"
                        Margin="8,0,0,0"
                        Padding="12,6"/>

            </StackPanel>
        </Border>

        <!-- 중앙 작업 영역 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Tracks}"
                             SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             Background="{DynamicResource CanvasBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding"
                                        Value="12,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,16,0,0">
                        <controls:TimelineSurface
                            Tracks="{Binding Tracks}"
                            AxisBrush="{DynamicResource SecondaryTextBrush}"
                            GridLineBrush="{DynamicResource DividerBrush}"/>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Rectangle Width="8" Height="8" Margin="0,0,5,0"
                                                   Fill="{Binding Id, Converter={StaticResource TrackBrushConverter}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="│ 0 ms   ▧ 종료 누락 (표시 범위까지)" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="INSPECTOR"
                             Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="선택한 Track"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Margin="0,24,0,6" />

                    <TextBlock Text="{Binding SelectedTrack.Name,
                                              TargetNullValue='선택 없음',
                                              FallbackValue='선택 없음'}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Track ID"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,20,0,6" />

                    <TextBlock Text="{Binding SelectedTrack.Id,
                                              TargetNullValue='—',
                                              FallbackValue='—'}"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Text="작업 목록"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Margin="0,24,0,8"/>

                    <ItemsControl ItemsSource="{Binding SelectedTrack.Spans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DurationText}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="12,6">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 배경: 순백색 대신 은은한 블루 화이트, 패널은 한 단계 차분한 톤 -->
    <SolidColorBrush
        x:Key="CanvasBrush"
        Color="#F7FAFD" />
    <SolidColorBrush
        x:Key="SurfaceBrush"
        Color="#EDF3F9" />
    <!-- 글자 -->
    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="#26384A" />
    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="#5C7085" />
    <!-- 경계 -->
    <SolidColorBrush
        x:Key="DividerBrush"
        Color="#CEDBE7" />
    <!-- 강조 -->
    <SolidColorBrush
        x:Key="AccentBrush"
        Color="#00B8D9" />
    <SolidColorBrush
        x:Key="AccentTextBrush"
        Color="#062B33" />
    <SolidColorBrush
        x:Key="RaisedBrush"
        Color="#E3ECF5" />
    <SolidColorBrush
        x:Key="GlassBrush"
        Color="#F5F0F6FC" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 배경 -->
    <SolidColorBrush x:Key="CanvasBrush"
                     Color="#252526" />

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#2D2D30" />

    <!-- 글자 -->
    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#F1F1F1" />

    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="#B8B8BF" />

    <!-- 경계 -->
    <SolidColorBrush x:Key="DividerBrush"
                     Color="#49494F" />

    <!-- 강조 -->
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#00D5F2" />

    <SolidColorBrush x:Key="AccentTextBrush"
                     Color="#062B33" />

</ResourceDictionary>